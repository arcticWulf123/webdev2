        {
          "name": "List Products (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('page size is 2', () => pm.expect(body.pageable.pageSize).to.eql(2));",
                  "pm.test('3 products total', () => pm.expect(body.totalElements).to.eql(3));",
                  "pm.test('2 pages', () => pm.expect(body.totalPages).to.eql(2));",
                  "pm.test('first page', () => pm.expect(body.first).to.eql(true));",
                  "pm.test('not the last page', () => pm.expect(body.last).to.eql(false));",
                  "pm.test('2 items in content', () => pm.expect(body.content).to.have.lengthOf(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?page=0&size=2&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "2" },
                { "key": "sort", "value": "name,asc" }
              ]
            }
          }
        },
