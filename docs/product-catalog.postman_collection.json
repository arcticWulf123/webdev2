                  "const body = pm.response.json();",
                  "pm.test('same category id', () => pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('categoryId'))));",
                  "pm.test('has name', () => pm.expect(body.name).to.be.a('string'));"
                ]
              }
            }
