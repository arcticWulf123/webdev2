    {
      "name": "1. Categories",
      "item": [
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Location header points at the new category', () => {",
                  "  pm.expect(pm.response.headers.get('Location')).to.match(/^\\/api\\/categories\\/\\d+$/);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('name echoed back', () => pm.expect(body.name).to.eql('Electronics'));",
                  "pm.test('id is a number', () => pm.expect(body.id).to.be.a('number'));",
                  "pm.collectionVariables.set('categoryId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Electronics\",\"description\":\"Devices and gadgets\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          }
        },
        {
          "name": "List Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns an array', () => pm.expect(body).to.be.an('array'));",
                  "pm.test('contains the created category', () => {",
                  "  const ids = body.map(c => c.id);",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('categoryId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          }
        },
        {
          "name": "Get Category by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
