          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "departments",
            "{{createdId}}"
          ]
        }
      }
    },
    {
      "name": "Patch department (PATCH)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Name was patched\", () => pm.expect(body.name).to.include(\"Research Patched\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
