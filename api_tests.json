          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/departments/{{createdId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "departments",
            "{{createdId}}"
          ]
        }
      }
    },
    {
      "name": "List departments (paginated)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Page metadata is present\", () => {",
              "  pm.expect(body).to.have.property(\"totalElements\");",
              "  pm.expect(body).to.have.property(\"totalPages\");",
              "  pm.expect(body.content).to.be.an(\"array\");",
              "});",
              "pm.test(\"Page size is 5\", () => pm.expect(body.size).to.eql(5));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/departments?page=0&size=5&sort=name,asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "departments"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "5"
            },
            {
              "key": "sort",
              "value": "name,asc"
            }
          ]
        }
      }
    },
    {
      "name": "Filter departments by name",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"At least one result\", () => pm.expect(body.content.length).to.be.above(0));",
              "pm.test(\"Every result matches the filter\", () => {",
              "  body.content.forEach((d) => pm.expect(d.name.toLowerCase()).to.include(\"research\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/departments?name=Research",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "departments"
          ],
          "query": [
            {
              "key": "name",
              "value": "Research"
            }
          ]
        }
      }
    },
    {
      "name": "List departments (size cap 100)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Requested 999 is capped to 100\", () => {",
              "  pm.expect(body.size).to.eql(100);",
              "  pm.expect(body.pageable.pageSize).to.eql(100);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/departments?size=999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "departments"
          ],
          "query": [
            {
              "key": "size",
              "value": "999"
            }
          ]
