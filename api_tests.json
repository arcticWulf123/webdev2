    },
    {
      "name": "Get non-existent department",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404\", () => pm.response.to.have.status(404));",
              "const body = pm.response.json();",
              "pm.test(\"ErrorResponse shape\", () => {",
              "  pm.expect(body.status).to.eql(404);",
              "  pm.expect(body.message).to.include(\"not found\");",
              "  pm.expect(body).to.have.property(\"timestamp\");",
              "});"
            ]
          }
        }
