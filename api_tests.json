          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400\", () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test(\"errors array is populated\", () => {",
              "  pm.expect(body.errors).to.be.an(\"array\");",
              "  pm.expect(body.errors.length).to.be.above(0);",
              "  pm.expect(body.errors[0].field).to.eql(\"name\");",
              "});"
            ]
          }
        }
