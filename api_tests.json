{
  "info": {
    "_postman_id": "b3f1c0a4-7d2e-4f5a-9c6b-1e8d4a2f9c11",
    "name": "Week11 - Jade Roland API",
    "description": "Week 11 lab collection for the Department API (pagination, validation, error handling). Run the app on http://localhost:8080 first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "createdId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create department (happy path)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"Returns created department\", () => {",
              "  pm.expect(body).to.have.property(\"id\");",
              "  pm.expect(body.name).to.include(\"Research\");",
              "});",
              "pm.collectionVariables.set(\"createdId\", body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Research {{$timestamp}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/departments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "departments"
          ]
        }
      }
    },
    {
      "name": "Get department by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Id matches created department\", () => pm.expect(String(body.id)).to.eql(String(pm.collectionVariables.get(\"createdId\"))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/departments/{{createdId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "departments",
            "{{createdId}}"
          ]
        }
      }
    },
    {
      "name": "Update department (PUT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"Name was updated\", () => pm.expect(body.name).to.include(\"Research Updated\"));"
